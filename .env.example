# Never place production or mainnet keys in this project.
# Use disposable, faucet-funded testnet accounts only.

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=0xYOUR_DISPOSABLE_TESTNET_DEPLOYER_KEY
ATTESTOR_PRIVATE_KEY=0xYOUR_SEPARATE_DISPOSABLE_ATTESTOR_KEY
ATTESTOR_ADDRESS=0x0000000000000000000000000000000000000000
# Local deployments default to deterministic Hardhat account 0.
LOCAL_ATTESTOR_ADDRESS=

# Confirmations observed before the relayer signs a source-chain event.
SEPOLIA_CONFIRMATIONS=12
BASE_SEPOLIA_CONFIRMATIONS=12
LOAN_DURATION_SECONDS=180
PUBLIC_DEMO_ALLOW_REPEAT=false

# Optional deployed addresses; generated deployment JSON is preferred.
CHAIN_A_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_A_MESSENGER_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_A_COLLATERAL_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_A_COLLATERAL_TOKEN_DEPLOY_TX=0xDEPLOYMENT_TRANSACTION_HASH
CHAIN_A_MESSENGER_DEPLOY_TX=0xDEPLOYMENT_TRANSACTION_HASH
CHAIN_B_POOL_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_B_MESSENGER_ADDRESS=0x0000000000000000000000000000000000000000
DEMO_BORROWER_ADDRESS=0x0000000000000000000000000000000000000000
RECOVERY_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000

# Configuration scripts default to local-a.json/local-b.json.
CHAIN_A_DEPLOYMENT_FILE=sepolia.json
CHAIN_B_DEPLOYMENT_FILE=baseSepolia.json
