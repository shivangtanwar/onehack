{
  "name": "databaes-cross-chain-lending",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-chain collateralized lending demo for ONE HACK W3A-3",
  "scripts": {
    "compile": "bash scripts/hardhat.sh compile",
    "test": "bash scripts/hardhat.sh test",
    "test:security": "bash scripts/hardhat.sh test test/security.spec.ts",
    "coverage": "bash scripts/hardhat.sh coverage",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'scripts/**/*.ts' 'test/**/*.ts' 'frontend/src/**/*.{ts,tsx,css}' 'frontend/*.{json,ts,html}' '*.{ts,json,md}'",
    "format:check": "prettier --check 'contracts/**/*.sol' 'scripts/**/*.ts' 'test/**/*.ts' 'frontend/src/**/*.{ts,tsx,css}' 'frontend/*.{json,ts,html}' '*.{ts,json,md}'",
    "node:a": "bash scripts/hardhat.sh --config hardhat.node-a.config.ts node --hostname 127.0.0.1 --port 8545",
    "node:b": "bash scripts/hardhat.sh --config hardhat.chain-b.config.ts node --hostname 127.0.0.1 --port 9545",
    "deploy:a": "bash scripts/hardhat.sh run scripts/deploy-chain-a.ts --network localhostA",
    "deploy:b": "bash scripts/hardhat.sh run scripts/deploy-chain-b.ts --network localhostB",
    "configure:a": "CHAIN_A_DEPLOYMENT_FILE=local-a.json CHAIN_B_DEPLOYMENT_FILE=local-b.json bash scripts/hardhat.sh run scripts/configure-chain-a.ts --network localhostA",
    "configure:b": "CHAIN_A_DEPLOYMENT_FILE=local-a.json CHAIN_B_DEPLOYMENT_FILE=local-b.json bash scripts/hardhat.sh run scripts/configure-chain-b.ts --network localhostB",
    "demo:local": "tsx scripts/local-demo.ts",
    "demo:public": "tsx scripts/public-demo.ts",
    "evidence:public": "tsx scripts/export-public-evidence.ts",
    "verify:sourcify": "tsx scripts/verify-sourcify.ts",
    "relayer": "tsx scripts/relayer.ts",
    "wallets:create": "tsx scripts/create-wallets.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.18",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.1",
    "solhint": "^6.2.4",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0"
  }
}
