{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "outDir": "dist"
  },
  "include": [
    "hardhat.config.ts",
    "hardhat.node-a.config.ts",
    "hardhat.chain-b.config.ts",
    "scripts",
    "test",
    "typechain-types"
  ],
  "exclude": ["frontend", "node_modules"]
}
